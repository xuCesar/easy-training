[Unit]
Description=Easy Training TLS certificate expiry check

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/easy-training-cert-expiry-check
User=root
Group=root
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/letsencrypt
ReadWritePaths=/var/lib/easy-training-monitoring
