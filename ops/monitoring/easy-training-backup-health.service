[Unit]
Description=Easy Training production backup health check

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/easy-training-backup-health-check
User=root
Group=root
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/mnt/cos-backup
ReadWritePaths=/var/lib/easy-training-monitoring
