{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.mjs",
		"test:integration": "tsc -p ../../packages/db/tests/tsconfig.json --noEmit && tsx --test src/app.test.ts ../../packages/db/tests/*.integration.ts"
	},
	"dependencies": {
		"@easy-training/api": "workspace:*",
		"@easy-training/auth": "workspace:*",
		"@easy-training/db": "workspace:*",
		"@easy-training/env": "workspace:*",
		"@hono/node-server": "^2.0.8",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"better-auth": "catalog:",
		"hono": "catalog:"
	},
	"devDependencies": {
		"@easy-training/config": "workspace:*",
		"@types/node": "catalog:",
		"tsdown": "^0.22.3",
		"tsx": "^4.22.5",
		"typescript": "catalog:"
	}
}
